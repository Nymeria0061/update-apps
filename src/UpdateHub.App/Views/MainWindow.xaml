<ui:FluentWindow
  x:Class="UpdateHub.App.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:pages="clr-namespace:UpdateHub.App.Views.Pages"
  Title="UpdateHub"
  Width="1180"
  Height="720"
  MinWidth="900"
  MinHeight="540"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      x:Name="TitleBar"
      Grid.Row="0"
      Title="UpdateHub">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/UpdateHub.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ui:NavigationView
      x:Name="RootNavigation"
      Grid.Row="1"
      FrameMargin="0"
      HeaderVisibility="Collapsed"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleVisible="True"
      OpenPaneLength="230"
      PaneDisplayMode="Left"
      TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}"
      Transition="FadeInWithSlide">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Genel Bakış" TargetPageType="{x:Type pages:DashboardPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Home24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Uygulamalar" TargetPageType="{x:Type pages:ApplicationsPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Apps24" />
          </ui:NavigationViewItem.Icon>
          <ui:NavigationViewItem.InfoBadge>
            <ui:InfoBadge
              Severity="Attention"
              Value="{Binding ViewModel.AppCount, Mode=OneWay}"
              Visibility="{Binding ViewModel.AppCount, Converter={StaticResource NotEmptyToVisibility}}" />
          </ui:NavigationViewItem.InfoBadge>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Windows ve Sürücüler" TargetPageType="{x:Type pages:WindowsUpdatesPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="ShieldCheckmark24" />
          </ui:NavigationViewItem.Icon>
          <ui:NavigationViewItem.InfoBadge>
            <ui:InfoBadge
              Severity="Attention"
              Value="{Binding ViewModel.WindowsAndDriverCount, Mode=OneWay}"
              Visibility="{Binding ViewModel.WindowsAndDriverCount, Converter={StaticResource NotEmptyToVisibility}}" />
          </ui:NavigationViewItem.InfoBadge>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="BIOS / UEFI" TargetPageType="{x:Type pages:FirmwarePage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="DeveloperBoard24" />
          </ui:NavigationViewItem.Icon>
          <ui:NavigationViewItem.InfoBadge>
            <ui:InfoBadge
              Severity="Caution"
              Value="{Binding ViewModel.FirmwareCount, Mode=OneWay}"
              Visibility="{Binding ViewModel.FirmwareCount, Converter={StaticResource NotEmptyToVisibility}}" />
          </ui:NavigationViewItem.InfoBadge>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Aygıtlar" TargetPageType="{x:Type pages:DevicesPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="UsbPlug24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Günlük" TargetPageType="{x:Type pages:LogPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="DocumentBulletList24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="Ayarlar" TargetPageType="{x:Type pages:SettingsPage}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Settings24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>

    <!-- Global status bar: what is happening right now, on every page -->
    <Border
      Grid.Row="2"
      Padding="16,8"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ui:ProgressRing
          Grid.Column="0"
          Width="18"
          Height="18"
          Margin="0,0,10,0"
          VerticalAlignment="Center"
          IsIndeterminate="True"
          Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <ui:SymbolIcon
          Grid.Column="0"
          Margin="0,0,10,0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Symbol="Info24"
          Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock
            FontSize="12"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{Binding ViewModel.StatusMessage}"
            TextTrimming="CharacterEllipsis" />
          <ProgressBar
            Height="4"
            Margin="0,6,0,0"
            IsIndeterminate="{Binding ViewModel.IsProgressIndeterminate}"
            Maximum="100"
            Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVisibility}}"
            Value="{Binding ViewModel.ProgressPercent, Mode=OneWay}" />
        </StackPanel>

        <ui:Button
          Grid.Column="2"
          Margin="12,0,0,0"
          Appearance="Secondary"
          Command="{Binding ViewModel.InstallAllCancelCommand}"
          Content="Durdur"
          Icon="{ui:SymbolIcon Stop24}"
          Visibility="{Binding ViewModel.IsInstalling, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button
          Grid.Column="3"
          Margin="12,0,0,0"
          Appearance="Primary"
          Command="{Binding ViewModel.RestartNowCommand}"
          Content="Yeniden başlat"
          Icon="{ui:SymbolIcon Power24}"
          Visibility="{Binding ViewModel.RebootRequired, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>

    <ContentPresenter
      x:Name="RootContentDialog"
      Grid.Row="0"
      Grid.RowSpan="3" />

    <ui:SnackbarPresenter
      x:Name="SnackbarPresenter"
      Grid.Row="1"
      MaxWidth="620"
      Margin="0,0,16,12"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom" />
  </Grid>
</ui:FluentWindow>
