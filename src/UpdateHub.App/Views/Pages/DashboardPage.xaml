<Page
  x:Class="UpdateHub.App.Views.Pages.DashboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Genel Bakış"
  d:DesignHeight="760"
  d:DesignWidth="1000"
  ScrollViewer.CanContentScroll="False"
  mc:Ignorable="d">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Style="{StaticResource PageRoot}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <StackPanel Grid.Row="0">
        <TextBlock Style="{StaticResource PageTitle}" Text="Genel Bakış" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Uygulamalar, Windows, sürücüler ve BIOS için tek yerden güncelleme. Yalnızca resmi kaynaklardaki kararlı sürümler kurulur." />
      </StackPanel>

      <!-- Notices -->
      <StackPanel Grid.Row="1" Margin="0,16,0,0">
        <ui:InfoBar
          Title="Yönetici izni gerekiyor"
          Margin="0,0,0,8"
          IsClosable="False"
          IsOpen="{Binding ViewModel.IsNotElevated, Mode=OneWay}"
          Message="Sürücü, Windows ve BIOS güncellemeleri için uygulamayı yönetici olarak çalıştırın."
          Severity="Warning" />
        <ui:InfoBar
          Title="Yeniden başlatma gerekiyor"
          Margin="0,0,0,8"
          IsClosable="True"
          IsOpen="{Binding ViewModel.Center.RebootRequired, Mode=TwoWay}"
          Message="Bazı güncellemeler ancak yeniden başlatmadan sonra tamamlanır."
          Severity="Informational">
          <ui:InfoBar.Content>
            <ui:Button
              Margin="0,4,0,8"
              Appearance="Primary"
              Command="{Binding ViewModel.Center.RestartNowCommand}"
              Content="Şimdi yeniden başlat"
              Icon="{ui:SymbolIcon Power24}" />
          </ui:InfoBar.Content>
        </ui:InfoBar>
      </StackPanel>

      <!-- Device + action card -->
      <Border
        Grid.Row="2"
        Padding="22,18"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <ui:SymbolIcon
            Grid.Column="0"
            Margin="0,0,20,0"
            VerticalAlignment="Top"
            FontSize="44"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
            Symbol="Laptop24" />

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Text="{Binding ViewModel.DeviceTitle}" />
            <TextBlock
              Margin="0,4,0,0"
              Style="{StaticResource Muted}"
              Text="{Binding ViewModel.OsLine}" />
            <TextBlock
              Style="{StaticResource Muted}"
              Text="{Binding ViewModel.CpuLine}" />
            <WrapPanel Margin="0,2,0,0">
              <TextBlock
                Margin="0,0,14,0"
                Style="{StaticResource Muted}"
                Text="{Binding ViewModel.MemoryLine}" />
              <TextBlock Style="{StaticResource Muted}" Text="{Binding ViewModel.GpuLine}" />
            </WrapPanel>
            <WrapPanel Margin="0,2,0,0">
              <TextBlock
                Margin="0,0,4,0"
                Style="{StaticResource Muted}"
                Text="BIOS:" />
              <TextBlock
                Margin="0,0,14,0"
                Style="{StaticResource Muted}"
                Text="{Binding ViewModel.BiosLine}" />
              <TextBlock Style="{StaticResource Muted}" Text="{Binding ViewModel.FirmwareLine}" />
            </WrapPanel>
          </StackPanel>

          <StackPanel
            Grid.Column="2"
            MinWidth="220"
            Margin="24,0,0,0"
            VerticalAlignment="Center">
            <ui:Button
              HorizontalAlignment="Stretch"
              Appearance="Secondary"
              Command="{Binding ViewModel.Center.ScanCommand}"
              Content="Güncellemeleri tara"
              Icon="{ui:SymbolIcon ArrowSync24}"
              Visibility="{Binding ViewModel.Center.IsScanning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            <ui:Button
              HorizontalAlignment="Stretch"
              Appearance="Secondary"
              Command="{Binding ViewModel.Center.ScanCancelCommand}"
              Content="Taramayı durdur"
              Icon="{ui:SymbolIcon Stop24}"
              Visibility="{Binding ViewModel.Center.IsScanning, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
              Margin="0,8,0,0"
              HorizontalAlignment="Stretch"
              Appearance="Primary"
              Command="{Binding ViewModel.Center.InstallAllCommand}"
              Content="{Binding ViewModel.Center.BulkCount, Converter={StaticResource Format}, ConverterParameter='Tümünü güncelle ({0})'}"
              Icon="{ui:SymbolIcon ArrowDownload24}"
              Visibility="{Binding ViewModel.Center.IsInstalling, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            <ui:Button
              Margin="0,8,0,0"
              HorizontalAlignment="Stretch"
              Appearance="Danger"
              Command="{Binding ViewModel.Center.InstallAllCancelCommand}"
              Content="Kurulumu durdur"
              Icon="{ui:SymbolIcon Stop24}"
              Visibility="{Binding ViewModel.Center.IsInstalling, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
              Margin="0,8,0,0"
              HorizontalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="{Binding ViewModel.Center.LastScanLabel}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Progress -->
      <StackPanel Grid.Row="3" Margin="0,14,0,0">
        <TextBlock
          Style="{StaticResource Muted}"
          Text="{Binding ViewModel.Center.StatusMessage}"
          TextTrimming="CharacterEllipsis" />
        <ProgressBar
          Height="6"
          Margin="0,8,0,0"
          IsIndeterminate="{Binding ViewModel.Center.IsProgressIndeterminate}"
          Maximum="100"
          Visibility="{Binding ViewModel.Center.IsBusy, Converter={StaticResource BoolToVisibility}}"
          Value="{Binding ViewModel.Center.ProgressPercent, Mode=OneWay}" />
      </StackPanel>

      <!-- Category tiles -->
      <UniformGrid
        Grid.Row="4"
        Margin="0,18,0,0"
        Columns="4">
        <ui:CardAction
          Margin="0,0,10,0"
          Command="{Binding ViewModel.GoToApplicationsCommand}"
          Icon="{ui:SymbolIcon Apps24}">
          <StackPanel>
            <TextBlock
              FontSize="28"
              FontWeight="SemiBold"
              Text="{Binding ViewModel.Center.AppCount}" />
            <TextBlock Style="{StaticResource Muted}" Text="Uygulama" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction
          Margin="5,0"
          Command="{Binding ViewModel.GoToWindowsCommand}"
          Icon="{ui:SymbolIcon ShieldCheckmark24}">
          <StackPanel>
            <TextBlock
              FontSize="28"
              FontWeight="SemiBold"
              Text="{Binding ViewModel.Center.WindowsCount}" />
            <TextBlock Style="{StaticResource Muted}" Text="Windows" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction
          Margin="5,0"
          Command="{Binding ViewModel.GoToWindowsCommand}"
          Icon="{ui:SymbolIcon UsbPlug24}">
          <StackPanel>
            <TextBlock
              FontSize="28"
              FontWeight="SemiBold"
              Text="{Binding ViewModel.Center.DriverCount}" />
            <TextBlock Style="{StaticResource Muted}" Text="Sürücü" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction
          Margin="10,0,0,0"
          Command="{Binding ViewModel.GoToFirmwareCommand}"
          Icon="{ui:SymbolIcon DeveloperBoard24}">
          <StackPanel>
            <TextBlock
              FontSize="28"
              FontWeight="SemiBold"
              Text="{Binding ViewModel.Center.FirmwareCount}" />
            <TextBlock Style="{StaticResource Muted}" Text="BIOS / Firmware" />
          </StackPanel>
        </ui:CardAction>
      </UniformGrid>

      <!-- Sources -->
      <StackPanel Grid.Row="5">
        <TextBlock Style="{StaticResource SectionTitle}" Text="Güncelleme kaynakları" />
        <ItemsControl ItemsSource="{Binding ViewModel.Center.Providers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border
                Margin="0,0,0,6"
                Padding="14,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Symbol="ErrorCircle24"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                  <ui:SymbolIcon
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="ScanDash24"
                    Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding Name}" />
                  <TextBlock
                    Grid.Column="2"
                    MaxWidth="520"
                    VerticalAlignment="Center"
                    Style="{StaticResource Muted}"
                    Text="{Binding Status}"
                    TextAlignment="Right"
                    TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
