<Page
  x:Class="UpdateHub.App.Views.Pages.LogPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Günlük"
  d:DesignHeight="760"
  d:DesignWidth="1000"
  mc:Ignorable="d">

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource PageTitle}" Text="Günlük" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding ViewModel.LogFile, Converter={StaticResource Format}, ConverterParameter='Tüm işlemler kaydedilir. Dosya: {0}'}" />
    </StackPanel>

    <StackPanel
      Grid.Row="1"
      Margin="0,14,0,10"
      Orientation="Horizontal">
      <ui:Button
        Margin="0,0,6,0"
        Command="{Binding ViewModel.CopyToClipboardCommand}"
        Content="Panoya kopyala"
        Icon="{ui:SymbolIcon Copy24}" />
      <ui:Button
        Margin="0,0,6,0"
        Command="{Binding ViewModel.OpenFolderCommand}"
        Content="Günlük klasörünü aç"
        Icon="{ui:SymbolIcon FolderOpen24}" />
      <ui:Button
        Command="{Binding ViewModel.ClearCommand}"
        Content="Ekranı temizle"
        Icon="{ui:SymbolIcon Broom24}" />
    </StackPanel>

    <ui:ListView
      Grid.Row="2"
      FontFamily="Cascadia Mono, Consolas, Courier New"
      FontSize="12"
      ItemsSource="{Binding ViewModel.Store.Entries}"
      SelectionMode="Extended"
      VirtualizingPanel.IsVirtualizing="True">
      <ui:ListView.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="{Binding Time}" />
            <TextBlock
              Grid.Column="1"
              FontWeight="SemiBold"
              Text="{Binding LevelLabel}" />
            <TextBlock
              Grid.Column="2"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{Binding ShortCategory}"
              TextTrimming="CharacterEllipsis" />
            <TextBlock
              Grid.Column="3"
              Text="{Binding Message}"
              TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ui:ListView.ItemTemplate>
    </ui:ListView>
  </Grid>
</Page>
