<Page
  x:Class="UpdateHub.App.Views.Pages.FirmwarePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="BIOS / UEFI"
  d:DesignHeight="760"
  d:DesignWidth="1000"
  mc:Ignorable="d">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Style="{StaticResource PageRoot}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Style="{StaticResource PageTitle}" Text="BIOS / UEFI" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Donanım yazılımı yalnızca üreticinin resmi aracı veya Windows Update üzerinden güncellenir. Üçüncü taraf BIOS dosyaları asla kullanılmaz." />
      </StackPanel>

      <ui:InfoBar
        Title="Dikkat"
        Grid.Row="1"
        Margin="0,14,0,0"
        IsClosable="False"
        IsOpen="True"
        Message="BIOS güncellemesi sırasında bilgisayarı kapatmayın, dizüstü bilgisayarı güç adaptörüne takılı tutun. BitLocker kullanıyorsanız kurtarma anahtarınızın elinizde olduğundan emin olun."
        Severity="Warning" />

      <!-- Current firmware -->
      <UniformGrid
        Grid.Row="2"
        Margin="0,14,0,0"
        Columns="2">
        <Border
          Margin="0,0,7,0"
          Padding="18,14"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="10">
          <StackPanel>
            <TextBlock
              FontSize="12"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="YÜKLÜ BIOS / UEFI" />
            <TextBlock
              Margin="0,6,0,0"
              FontSize="20"
              FontWeight="SemiBold"
              Text="{Binding ViewModel.BiosVersion}" />
            <TextBlock
              Style="{StaticResource Muted}"
              Text="{Binding ViewModel.BiosDate}"
              Visibility="{Binding ViewModel.BiosDate, Converter={StaticResource NotEmptyToVisibility}}" />
            <TextBlock
              Margin="0,6,0,0"
              Style="{StaticResource Muted}"
              Text="{Binding ViewModel.BoardLine}" />
          </StackPanel>
        </Border>

        <Border
          Margin="7,0,0,0"
          Padding="18,14"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="10">
          <StackPanel>
            <TextBlock
              FontSize="12"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="ÜRETİCİ ARACI" />
            <TextBlock
              Margin="0,6,0,0"
              FontSize="16"
              FontWeight="SemiBold"
              Text="{Binding ViewModel.Guidance.VendorName}" />
            <TextBlock
              Margin="0,4,0,0"
              Style="{StaticResource Muted}"
              Text="{Binding ViewModel.ToolStatusLabel}" />
            <TextBlock
              Margin="0,6,0,0"
              FontSize="12"
              Style="{StaticResource Muted}"
              Text="{Binding ViewModel.Guidance.Notes}" />
            <WrapPanel Margin="0,12,0,0">
              <ui:Button
                Margin="0,0,6,6"
                Appearance="Primary"
                Command="{Binding ViewModel.InstallToolCommand}"
                Content="{Binding ViewModel.Guidance.ToolName, Converter={StaticResource Format}, ConverterParameter='{}{0} kur (winget)'}"
                Icon="{ui:SymbolIcon ArrowDownload24}"
                Visibility="{Binding ViewModel.CanInstallTool, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button
                Margin="0,0,6,6"
                Command="{Binding ViewModel.OpenToolDownloadPageCommand}"
                Content="Aracın resmi sayfası"
                Icon="{ui:SymbolIcon Open24}"
                Visibility="{Binding ViewModel.HasToolDownloadUrl, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button
                Margin="0,0,6,6"
                Command="{Binding ViewModel.OpenSupportPageCommand}"
                Content="Resmi destek sayfası"
                Icon="{ui:SymbolIcon Globe24}" />
              <ui:Button
                Margin="0,0,6,6"
                Command="{Binding ViewModel.Center.ScanCommand}"
                Content="Yeniden tara"
                Icon="{ui:SymbolIcon ArrowSync24}" />
            </WrapPanel>
            <ui:ProgressRing
              Width="22"
              Height="22"
              Margin="0,4,0,0"
              HorizontalAlignment="Left"
              IsIndeterminate="True"
              Visibility="{Binding ViewModel.IsInstallingTool, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <TextBlock
        Grid.Row="3"
        Style="{StaticResource SectionTitle}"
        Text="Bulunan donanım yazılımı güncellemeleri" />

      <Grid Grid.Row="4">
        <ItemsControl ItemTemplate="{StaticResource UpdateItemTemplate}" ItemsSource="{Binding ViewModel.View}" />
        <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource BoolToVisibility}}">
          <ui:SymbolIcon
            HorizontalAlignment="Center"
            FontSize="40"
            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
            Symbol="CheckmarkCircle24" />
          <TextBlock
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            FontWeight="SemiBold"
            Text="Bekleyen BIOS / firmware güncellemesi bulunamadı" />
          <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource Muted}"
            Text="Üretici aracı kurulu değilse yalnızca Windows Update üzerinden dağıtılan donanım yazılımı taranır." />
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
