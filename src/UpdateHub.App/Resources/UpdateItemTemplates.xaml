<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:conv="clr-namespace:UpdateHub.App.Converters"
  xmlns:vm="clr-namespace:UpdateHub.App.ViewModels">

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
  <conv:InverseBoolConverter x:Key="InverseBool" />
  <conv:NullableDoubleConverter x:Key="NullableDouble" />
  <conv:FormatConverter x:Key="Format" />

  <!-- Row border colour follows the install state so results are visible at a glance. -->
  <Style x:Key="UpdateRowBorder" TargetType="Border">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsBusy}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsDone}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsFailed}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="StatusMessageText" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsFailed}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsDone}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- One update row. Shared by the Applications, Windows & Drivers and Firmware pages. -->
  <DataTemplate x:Key="UpdateItemTemplate" DataType="{x:Type vm:UpdateItemViewModel}">
    <Border Style="{StaticResource UpdateRowBorder}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <CheckBox
          Grid.Column="0"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          IsChecked="{Binding IsSelected, Mode=TwoWay}"
          IsEnabled="{Binding IsActionable}"
          Visibility="{Binding ShowCheckbox, Converter={StaticResource BoolToVisibility}}" />

        <ui:SymbolIcon
          Grid.Column="1"
          Margin="0,0,14,0"
          VerticalAlignment="Center"
          FontSize="24"
          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
          Symbol="{Binding CategorySymbol}" />

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <WrapPanel>
            <TextBlock
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              FontSize="14"
              FontWeight="SemiBold"
              Text="{Binding Name}"
              TextTrimming="CharacterEllipsis" />
            <ui:Badge
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Appearance="Secondary"
              Content="{Binding Source}" />
            <ui:Badge
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Appearance="Caution"
              Content="Ön sürüm"
              Visibility="{Binding IsPreRelease, Converter={StaticResource BoolToVisibility}}" />
            <ui:Badge
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Appearance="Danger"
              Content="{Binding SeverityLabel}"
              Visibility="{Binding IsCriticalOrImportant, Converter={StaticResource BoolToVisibility}}" />
            <ui:Badge
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Appearance="Info"
              Content="Yeniden başlatma"
              Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisibility}}" />
          </WrapPanel>

          <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
            <TextBlock
              FontSize="12"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{Binding VersionChange}"
              Visibility="{Binding HasVersionChange, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
              Margin="8,0,0,0"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="{Binding SizeLabel}"
              Visibility="{Binding HasSize, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
              Margin="8,0,0,0"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="{Binding Publisher}"
              Visibility="{Binding Publisher, Converter={StaticResource NotEmptyToVisibility}}" />
          </StackPanel>

          <TextBlock
            MaxHeight="36"
            Margin="0,4,0,0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="{Binding Description}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap"
            Visibility="{Binding Description, Converter={StaticResource NotEmptyToVisibility}}" />

          <TextBlock
            Margin="0,4,0,0"
            FontSize="12"
            Foreground="{DynamicResource SystemFillColorCautionBrush}"
            Text="{Binding ManualInstructions}"
            TextWrapping="Wrap"
            Visibility="{Binding ManualInstructions, Converter={StaticResource NotEmptyToVisibility}}" />

          <TextBlock
            Style="{StaticResource StatusMessageText}"
            Text="{Binding StatusMessage}"
            Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}" />

          <ProgressBar
            Height="4"
            Margin="0,6,0,0"
            Maximum="100"
            Value="{Binding Progress, Converter={StaticResource NullableDouble}, Mode=OneWay}"
            Visibility="{Binding Progress, Converter={StaticResource NotEmptyToVisibility}}" />
        </StackPanel>

        <StackPanel
          Grid.Column="3"
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          Orientation="Horizontal">

          <!-- State badges: exactly one of these is visible once something happened -->
          <ui:ProgressRing
            Width="20"
            Height="20"
            Margin="0,0,8,0"
            IsIndeterminate="True"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <ui:Badge
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Appearance="Info"
            Content="{Binding StateLabel}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <ui:Badge
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Appearance="Success"
            Content="{Binding StateLabel}"
            Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
          <ui:Badge
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Appearance="Danger"
            Content="{Binding StateLabel}"
            Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
          <ui:Badge
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Appearance="Caution"
            Content="{Binding StateLabel}"
            Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />

          <ui:Button
            Appearance="Primary"
            Command="{Binding InstallCommand}"
            Content="{Binding InstallButtonLabel}"
            Icon="{ui:SymbolIcon ArrowDownload24}"
            Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVisibility}}" />

          <ui:DropDownButton
            Margin="6,0,0,0"
            Appearance="Secondary"
            Icon="{ui:SymbolIcon MoreHorizontal24}">
            <ui:DropDownButton.Flyout>
              <ContextMenu>
                <ui:MenuItem
                  Command="{Binding OpenInfoCommand}"
                  Header="Bilgi sayfasını aç"
                  Icon="{ui:SymbolIcon Open24}"
                  IsEnabled="{Binding HasInfoUrl}" />
                <ui:MenuItem
                  Command="{Binding ExcludeCommand}"
                  Header="Bu güncellemeyi yoksay"
                  Icon="{ui:SymbolIcon Eye24}" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- Install-result banner shown above every update list after an install run -->
  <DataTemplate x:Key="InstallSummaryBanner" DataType="{x:Type vm:UpdateCenterViewModel}">
    <Border
      Margin="0,0,0,10"
      Padding="14,10"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8"
      Visibility="{Binding HasLastInstallSummary, Converter={StaticResource BoolToVisibility}}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding LastInstallHadFailures}" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon
          Grid.Column="0"
          Margin="0,0,10,0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource SystemFillColorSuccessBrush}"
          Symbol="CheckmarkCircle24"
          Visibility="{Binding LastInstallHadFailures, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        <ui:SymbolIcon
          Grid.Column="0"
          Margin="0,0,10,0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource SystemFillColorCriticalBrush}"
          Symbol="Warning24"
          Visibility="{Binding LastInstallHadFailures, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          FontWeight="SemiBold"
          Text="{Binding LastInstallSummary}"
          TextWrapping="Wrap" />
        <ui:Button
          Grid.Column="2"
          Margin="10,0,0,0"
          Appearance="Primary"
          Command="{Binding RestartNowCommand}"
          Content="Yeniden başlat"
          Icon="{ui:SymbolIcon Power24}"
          Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVisibility}}" />
        <ui:Button
          Grid.Column="3"
          Margin="6,0,0,0"
          Command="{Binding ScanCommand}"
          Content="Yeniden tara"
          Icon="{ui:SymbolIcon ArrowSync24}" />
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
