<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:UpdateHub.App.ViewModels">

  <!-- One update row. Shared by the Applications, Windows & Drivers and Firmware pages. -->
  <DataTemplate x:Key="UpdateItemTemplate" DataType="{x:Type vm:UpdateItemViewModel}">
    <Border
      Margin="0,0,0,8"
      Padding="14,12"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <CheckBox
          Grid.Column="0"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          IsChecked="{Binding IsSelected, Mode=TwoWay}"
          IsEnabled="{Binding IsActionable}"
          Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />

        <ui:SymbolIcon
          Grid.Column="1"
          Margin="0,0,14,0"
          VerticalAlignment="Center"
          FontSize="24"
          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
          Symbol="{Binding CategorySymbol}" />

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <WrapPanel>
            <TextBlock
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              FontSize="14"
              FontWeight="SemiBold"
              Text="{Binding Name}"
              TextTrimming="CharacterEllipsis" />
            <ui:Badge
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Appearance="Secondary"
              Content="{Binding Source}" />
            <ui:Badge
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Appearance="Caution"
              Content="Ön sürüm"
              Visibility="{Binding IsPreRelease, Converter={StaticResource BoolToVisibility}}" />
            <ui:Badge
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Appearance="Danger"
              Content="{Binding SeverityLabel}"
              Visibility="{Binding IsCriticalOrImportant, Converter={StaticResource BoolToVisibility}}" />
            <ui:Badge
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Appearance="Info"
              Content="Yeniden başlatma"
              Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisibility}}" />
          </WrapPanel>

          <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
            <TextBlock
              FontSize="12"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{Binding VersionChange}"
              Visibility="{Binding HasVersionChange, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
              Margin="8,0,0,0"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="{Binding SizeLabel}"
              Visibility="{Binding HasSize, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
              Margin="8,0,0,0"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="{Binding Publisher}"
              Visibility="{Binding Publisher, Converter={StaticResource NotEmptyToVisibility}}" />
          </StackPanel>

          <TextBlock
            MaxHeight="36"
            Margin="0,4,0,0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="{Binding Description}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap"
            Visibility="{Binding Description, Converter={StaticResource NotEmptyToVisibility}}" />

          <TextBlock
            Margin="0,4,0,0"
            FontSize="12"
            Foreground="{DynamicResource SystemFillColorCautionBrush}"
            Text="{Binding ManualInstructions}"
            TextWrapping="Wrap"
            Visibility="{Binding ManualInstructions, Converter={StaticResource NotEmptyToVisibility}}" />

          <TextBlock
            Margin="0,4,0,0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding StatusMessage}"
            TextTrimming="CharacterEllipsis"
            Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}" />

          <ProgressBar
            Height="4"
            Margin="0,6,0,0"
            Maximum="100"
            Value="{Binding Progress, Converter={StaticResource NullableDouble}, Mode=OneWay}"
            Visibility="{Binding Progress, Converter={StaticResource NotEmptyToVisibility}}" />
        </StackPanel>

        <StackPanel
          Grid.Column="3"
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          Orientation="Horizontal">

          <ui:ProgressRing
            Width="20"
            Height="20"
            Margin="0,0,10,0"
            IsIndeterminate="True"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

          <ui:SymbolIcon
            Margin="0,0,6,0"
            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
            Symbol="CheckmarkCircle24"
            Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />

          <ui:SymbolIcon
            Margin="0,0,6,0"
            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
            Symbol="ErrorCircle24"
            Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />

          <TextBlock
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding StateLabel}" />

          <ui:Button
            Appearance="Primary"
            Command="{Binding InstallCommand}"
            Content="Güncelle"
            Icon="{ui:SymbolIcon ArrowDownload24}"
            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />

          <ui:DropDownButton
            Margin="6,0,0,0"
            Appearance="Secondary"
            Icon="{ui:SymbolIcon MoreHorizontal24}">
            <ui:DropDownButton.Flyout>
              <ContextMenu>
                <ui:MenuItem
                  Command="{Binding OpenInfoCommand}"
                  Header="Bilgi sayfasını aç"
                  Icon="{ui:SymbolIcon Open24}"
                  IsEnabled="{Binding HasInfoUrl}" />
                <ui:MenuItem
                  Command="{Binding ExcludeCommand}"
                  Header="Bu güncellemeyi yoksay"
                  Icon="{ui:SymbolIcon Eye24}" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- Compact list header used above each update list -->
  <Style x:Key="ListToolbar" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Margin" Value="0,14,0,10" />
  </Style>
</ResourceDictionary>
